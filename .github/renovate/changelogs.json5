{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Changelog sources for packages without (or with a wrong) source label",
  packageRules: [
    // Release notes come from GitHub releases/tags of sourceUrl. Packages with
    // no (or a wrong) org.opencontainers.image.source label get one here;
    // changelogUrl is a link-only fallback where upstream tags don't match.
    {
      matchPackageNames: ["registry.k8s.io/kubectl"],
      sourceUrl: "https://github.com/kubernetes/kubernetes",
    },
    {
      matchPackageNames: ["/dragonfly-operator/", "ghcr.io/dragonflydb/operator"],
      sourceUrl: "https://github.com/dragonflydb/dragonfly-operator",
    },
    {
      matchPackageNames: ["ghcr.io/dragonflydb/dragonfly"],
      sourceUrl: "https://github.com/dragonflydb/dragonfly",
    },
    {
      matchPackageNames: ["public.ecr.aws/aws-cli/aws-cli"],
      sourceUrl: "https://github.com/aws/aws-cli",
    },
    {
      description: "Labels are read from the highest tag, a commit-hash build (e.g. 8588859) with none",
      matchPackageNames: ["quay.io/victoriametrics/operator"],
      sourceUrl: "https://github.com/VictoriaMetrics/operator",
    },
    {
      matchPackageNames: ["/^(docker\\.io/)?democraticcsi/democratic-csi$/", "ghcr.io/democratic-csi/democratic-csi"],
      sourceUrl: "https://github.com/democratic-csi/democratic-csi",
    },
    {
      matchPackageNames: ["ghcr.io/grpc-ecosystem/grpc-health-probe"],
      sourceUrl: "https://github.com/grpc-ecosystem/grpc-health-probe",
    },
    {
      matchPackageNames: ["ghcr.io/k8s-gateway/k8s_gateway"],
      sourceUrl: "https://github.com/k8s-gateway/k8s_gateway",
    },
    {
      matchPackageNames: ["ghcr.io/fluent/fluent-operator/fluent-bit"],
      sourceUrl: "https://github.com/fluent/fluent-bit",
    },
    {
      description: "Chart versions match the app's vX.Y.Z releases",
      matchPackageNames: ["spegel", "ghcr.io/spegel-org/helm-charts/spegel"],
      sourceUrl: "https://github.com/spegel-org/spegel",
    },
    {
      matchPackageNames: ["ghcr.io/jellyfin/jellyfin"],
      sourceUrl: "https://github.com/jellyfin/jellyfin",
    },
    {
      description: "Tags track the bundled kubectl version",
      matchPackageNames: ["docker.io/alpine/k8s"],
      sourceUrl: "https://github.com/kubernetes/kubernetes",
    },
    {
      description: "Tags track the bundled helm version",
      matchPackageNames: ["alpine/helm"],
      sourceUrl: "https://github.com/helm/helm",
    },
    {
      description: "Source label is the chainguard static base image",
      matchPackageNames: ["ghcr.io/postfinance/topf"],
      sourceUrl: "https://github.com/postfinance/topf",
    },
    {
      matchPackageNames: ["quay.io/prometheuscommunity/smartctl-exporter"],
      sourceUrl: "https://github.com/prometheus-community/smartctl_exporter",
    },
    {
      matchPackageNames: ["quay.io/k8tz/k8tz"],
      sourceUrl: "https://github.com/k8tz/k8tz",
    },
    {
      description: "Source label points at chainguard-images/images",
      matchPackageNames: ["ghcr.io/grafana/grafana-operator", "ghcr.io/grafana/helm-charts/grafana-operator"],
      sourceUrl: "https://github.com/grafana/grafana-operator",
    },
    {
      description: "Source label points at chainguard-images/images",
      matchPackageNames: ["ghcr.io/postfinance/kubelet-csr-approver"],
      sourceUrl: "https://github.com/postfinance/kubelet-csr-approver",
    },
    {
      description: "Source label points at a Rocky Linux build repo",
      matchPackageNames: ["quay.io/cephcsi/cephcsi"],
      sourceUrl: "https://github.com/ceph/ceph-csi",
    },
    {
      description: "Operator image + the drivers chart mirror (same vX.Y.Z releases)",
      matchPackageNames: ["quay.io/cephcsi/ceph-csi-operator", "ghcr.io/home-operations/charts-mirror/ceph-csi-drivers"],
      sourceUrl: "https://github.com/ceph/ceph-csi-operator",
    },
    {
      matchPackageNames: ["/^ghcr\\.io/goharbor//"],
      sourceUrl: "https://github.com/goharbor/harbor",
    },
    {
      description: "Source label points at the app repo (v2.x); chart releases are in harbor-helm",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/harbor"],
      sourceUrl: "https://github.com/goharbor/harbor-helm",
    },
    {
      matchPackageNames: ["/^ghcr\\.io/kyverno/(kyverno|kyvernopre|kyverno-cli|background-controller|cleanup-controller|reports-controller)$/"],
      sourceUrl: "https://github.com/kyverno/kyverno",
    },
    {
      matchPackageNames: ["ghcr.io/cloudnative-pg/plugin-barman-cloud", "ghcr.io/cloudnative-pg/plugin-barman-cloud-sidecar"],
      sourceUrl: "https://github.com/cloudnative-pg/plugin-barman-cloud",
    },
    {
      description: "Chart mirror + image (same vX.Y.Z releases)",
      matchPackageNames: ["docker.io/rocm/k8s-gpu-dra-driver", "ghcr.io/home-operations/charts-mirror/k8s-gpu-dra-driver"],
      sourceUrl: "https://github.com/ROCm/k8s-gpu-dra-driver",
    },
    {
      matchPackageNames: ["quay.io/prometheuscommunity/json-exporter"],
      sourceUrl: "https://github.com/prometheus-community/json_exporter",
    },
    {
      description: "Release tags are X.Y.Z; versioning strips the pg<N>-v prefix",
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"],
      sourceUrl: "https://github.com/tensorchord/VectorChord",
    },
    {
      description: "Images + charts share the app's vX.Y.Z releases",
      matchPackageNames: ["/^ghcr\\.io/soliddowant/(charts/)?tape-archiver/"],
      sourceUrl: "https://github.com/solidDoWant/tape-archiver",
    },
    // kubernetes-csi sidecars (rook-ceph, openebs, democratic-csi, volume-snapshot groups)
    {
      matchPackageNames: ["registry.k8s.io/sig-storage/snapshot-controller", "registry.k8s.io/sig-storage/csi-snapshotter"],
      sourceUrl: "https://github.com/kubernetes-csi/external-snapshotter",
    },
    {
      matchPackageNames: ["registry.k8s.io/sig-storage/csi-provisioner"],
      sourceUrl: "https://github.com/kubernetes-csi/external-provisioner",
    },
    {
      matchPackageNames: ["registry.k8s.io/sig-storage/csi-resizer"],
      sourceUrl: "https://github.com/kubernetes-csi/external-resizer",
    },
    {
      matchPackageNames: ["registry.k8s.io/sig-storage/csi-attacher"],
      sourceUrl: "https://github.com/kubernetes-csi/external-attacher",
    },
    {
      matchPackageNames: ["registry.k8s.io/sig-storage/csi-node-driver-registrar"],
      sourceUrl: "https://github.com/kubernetes-csi/node-driver-registrar",
    },
    {
      matchPackageNames: ["registry.k8s.io/metrics-server/metrics-server"],
      sourceUrl: "https://github.com/kubernetes-sigs/metrics-server",
    },
    {
      matchPackageNames: ["registry.k8s.io/coredns/coredns"],
      sourceUrl: "https://github.com/coredns/coredns",
    },
    {
      description: "Rook operator image; shares the charts' vX.Y.Z releases",
      matchPackageNames: ["ghcr.io/rook/ceph"],
      sourceUrl: "https://github.com/rook/rook",
    },
    {
      matchDatasources: ["pypi"],
      matchPackageNames: ["omsdk"],
      sourceUrl: "https://github.com/dell/omsdk",
    },
    {
      description: "Changelog lives in the README",
      matchDatasources: ["pypi"],
      matchPackageNames: ["bcrypt"],
      changelogUrl: "https://github.com/pyca/bcrypt#changelog",
    },
    {
      description: "Tags are vX.Y; images are X.Y.Z",
      matchPackageNames: ["ghcr.io/home-operations/nzbget"],
      changelogUrl: "https://github.com/nzbgetcom/nzbget/releases",
    },
    {
      description: "Floating X.Y tags don't match vX.Y.Z releases",
      matchPackageNames: ["hashicorp/terraform"],
      changelogUrl: "https://github.com/hashicorp/terraform/releases",
    },
    {
      description: "Tags are gpu-vX.Y.Z; release notes fall back to extractVersion for tag matching",
      matchPackageNames: ["/intel-gpu-resource-driver/"],
      extractVersion: "^(?:gpu-v)?(?<version>.+)$",
    },
    {
      description: "Tags are version/X.Y.Z; release notes fall back to extractVersion for tag matching",
      matchPackageNames: ["ghcr.io/goauthentik/server"],
      extractVersion: "^(?:version/)?(?<version>.+)$",
    },
    {
      description: "Image repo stopped tagging at 1.29.x; nginx tags are release-X.Y.Z",
      matchPackageNames: ["public.ecr.aws/nginx/nginx-unprivileged"],
      sourceUrl: "https://github.com/nginx/nginx",
      extractVersion: "^(?:release-)?(?<version>.+)$",
    },
    {
      description: "Tags are release-X.Y.Z; release notes fall back to extractVersion for tag matching",
      matchPackageNames: ["ghcr.io/home-operations/qbittorrent"],
      extractVersion: "^(?:release-)?(?<version>.+)$",
    },
    {
      description: "kubernetes/autoscaler monorepo; VPA tags are vertical-pod-autoscaler-X.Y.Z",
      matchPackageNames: ["registry.k8s.io/autoscaling/vpa-recommender"],
      sourceUrl: "https://github.com/kubernetes/autoscaler",
      extractVersion: "^(?:vertical-pod-autoscaler-)?(?<version>.+)$",
    },
    {
      description: "talos-factory custom datasource (talosFactory preset) has no source",
      matchDatasources: ["custom.talos-factory"],
      sourceUrl: "https://github.com/siderolabs/talos",
    },
    // Coder registry modules: monorepo tagged release/coder/<module>/vX.Y.Z.
    // extractVersion is per module so sibling modules' tags can't match.
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["/^registry\\.coder\\.com/coder//"],
      sourceUrl: "https://github.com/coder/registry",
    },
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["registry.coder.com/coder/claude-code/coder"],
      extractVersion: "^(?:release/coder/claude-code/v)?(?<version>\\d.*)$",
    },
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["registry.coder.com/coder/git-commit-signing/coder"],
      extractVersion: "^(?:release/coder/git-commit-signing/v)?(?<version>\\d.*)$",
    },
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["registry.coder.com/coder/agentapi/coder"],
      extractVersion: "^(?:release/coder/agentapi/v)?(?<version>\\d.*)$",
    },
    {
      description: "Chart source points at the app repo; chart tags are coredns-X.Y.Z",
      matchPackageNames: ["coredns", "ghcr.io/coredns/charts/coredns"],
      sourceUrl: "https://github.com/coredns/helm",
      extractVersion: "^(?:coredns-)?(?<version>.+)$",
    },
    {
      description: "Chart source points at the app repo; chart tags are prometheus-smartctl-exporter-X.Y.Z",
      matchPackageNames: ["ghcr.io/prometheus-community/charts/prometheus-smartctl-exporter"],
      sourceUrl: "https://github.com/prometheus-community/helm-charts",
      extractVersion: "^(?:prometheus-smartctl-exporter-)?(?<version>.+)$",
    },
    {
      description: "Chart source points at the operator repo (v3.x); chart tags are fluent-operator-X.Y.Z",
      matchPackageNames: ["ghcr.io/fluent/helm-charts/fluent-operator"],
      sourceUrl: "https://github.com/fluent/helm-charts",
      extractVersion: "^(?:fluent-operator-)?(?<version>.+)$",
    },
    {
      matchPackageNames: ["ghcr.io/fluent/helm-charts/fluent-operator-fluent-bit-crds"],
      sourceUrl: "https://github.com/fluent/helm-charts",
      extractVersion: "^(?:fluent-operator-fluent-bit-crds-)?(?<version>.+)$",
    },
    {
      matchPackageNames: ["ghcr.io/fluent/helm-charts/fluent-operator-fluentd-crds"],
      sourceUrl: "https://github.com/fluent/helm-charts",
      extractVersion: "^(?:fluent-operator-fluentd-crds-)?(?<version>.+)$",
    },
    {
      description: "Chart tags are cloudnative-pg-vX.Y.Z",
      matchPackageNames: ["ghcr.io/cloudnative-pg/charts/cloudnative-pg"],
      extractVersion: "^(?:cloudnative-pg-v)?(?<version>.+)$",
    },
    {
      description: "Chart source points at the plugin repo; chart tags are plugin-barman-cloud-vX.Y.Z",
      matchPackageNames: ["ghcr.io/cloudnative-pg/charts/plugin-barman-cloud"],
      sourceUrl: "https://github.com/cloudnative-pg/charts",
      extractVersion: "^(?:plugin-barman-cloud-v)?(?<version>.+)$",
    },
    {
      description: "Chart source points at the app repo; chart tags are snapshot-controller-X.Y.Z",
      matchPackageNames: ["ghcr.io/piraeusdatastore/helm-charts/snapshot-controller"],
      sourceUrl: "https://github.com/piraeusdatastore/helm-charts",
      extractVersion: "^(?:snapshot-controller-)?(?<version>.+)$",
    },
    {
      description: "Chart tags are democratic-csi-X.Y.Z",
      matchPackageNames: ["ghcr.io/democratic-csi/charts/democratic-csi"],
      sourceUrl: "https://github.com/democratic-csi/charts",
      extractVersion: "^(?:democratic-csi-)?(?<version>.+)$",
    },
    // Monorepo chart tags (<chart>-helm-chart-X.Y.Z) don't match; link the chart changelog.
    {
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/external-dns"],
      changelogUrl: "https://github.com/kubernetes-sigs/external-dns/blob/master/charts/external-dns/CHANGELOG.md",
    },
    {
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/metrics-server"],
      changelogUrl: "https://github.com/kubernetes-sigs/metrics-server/blob/master/charts/metrics-server/CHANGELOG.md",
    },
    {
      description: "Teleport's GitHub releases lag its charts/images",
      matchPackageNames: ["/^teleport-/", "/gravitational\\/(tbot|teleport)/"],
      changelogUrl: "https://goteleport.com/docs/changelog/",
    },
    {
      matchPackageNames: ["registry.k8s.io/pause"],
      changelogUrl: "https://github.com/kubernetes/kubernetes/blob/master/build/pause/CHANGELOG.md",
    },
    {
      description: "Tags are kustomize/vX.Y.Z",
      matchPackageNames: ["registry.k8s.io/kustomize/kustomize"],
      changelogUrl: "https://github.com/kubernetes-sigs/kustomize/releases",
    },
    {
      description: "contrib-/distroless- tags don't match envoy's vX.Y.Z releases",
      matchPackageNames: ["docker.io/envoyproxy/envoy"],
      changelogUrl: "https://github.com/envoyproxy/envoy/releases",
    },
    {
      matchPackageNames: ["public.ecr.aws/docker/library/python"],
      changelogUrl: "https://docs.python.org/3/whatsnew/changelog.html",
    },
    {
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      changelogUrl: "https://www.postgresql.org/docs/release/",
    },
    {
      description: "Container repo has no releases; upstream tags are pgbouncer_X_Y_Z",
      matchPackageNames: ["ghcr.io/cloudnative-pg/pgbouncer"],
      changelogUrl: "https://www.pgbouncer.org/changelog.html",
    },
    {
      description: "GitHub releases have empty bodies; notes are published on kiali.io",
      matchPackageNames: ["kiali-server", "quay.io/kiali/kiali"],
      changelogUrl: "https://kiali.io/news/release-notes/",
    },
    {
      matchPackageNames: ["quay.io/curl/curl"],
      changelogUrl: "https://curl.se/changes.html",
    },
    // FairwindsOps/charts has no tags/releases; the chart dir history is the changelog.
    {
      matchDatasources: ["helm"],
      matchPackageNames: ["vpa"],
      changelogUrl: "https://github.com/FairwindsOps/charts/commits/master/stable/vpa",
    },
    {
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/goldilocks"],
      changelogUrl: "https://github.com/FairwindsOps/charts/commits/master/stable/goldilocks",
    },
  ],
}
