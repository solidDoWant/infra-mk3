#cloud-config
# Per-workspace boot config. The image (../image) provides the coder-agent unit,
# the persistent disk, and CA trust; this supplies only per-workspace values.
#
# Use `bootcmd`, never `write_files`/`runcmd`: only bootcmd runs on every boot.
# The root disk persists and KubeVirt's NoCloud instance-id is the VM UID, so
# once-per-instance modules fire only on a root disk's first boot - which would
# strand restarted workspaces on the previous build's agent token.
hostname: ${HOSTNAME}
preserve_hostname: false

bootcmd:
  # Agent environment, read by coder-agent.service via EnvironmentFile. base64
  # avoids YAML-escaping the values; umask keeps the token file 0600.
  - [ sh, -c, 'umask 077; mkdir -p /etc/coder; printf %s "${AGENT_ENV_B64}" | base64 -d > /etc/coder/agent.env' ]

  # Read by coder-set-hostname.service, the authoritative hostname source (the
  # `hostname:` key above is only an early hint). Ordered before Teleport.
  - [ sh, -c, 'mkdir -p /etc/coder; printf %s "${HOSTNAME}" > /etc/coder/hostname; chmod 0644 /etc/coder/hostname' ]

%{ if ENABLE_NFS ~}
# nofail/_netdev keep boot resilient if the server is unreachable.
mounts:
  - [ "${NFS_ADDRESS}:${NFS_PATH}", "${NFS_MOUNT_PATH}", "nfs", "defaults,nofail,_netdev", "0", "0" ]
%{ endif ~}
