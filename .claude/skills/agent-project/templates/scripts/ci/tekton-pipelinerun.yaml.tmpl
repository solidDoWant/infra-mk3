# The template of the CI PipelineRuns in .tekton/. scripts/ci/tekton-generate.sh
# (`make generate`) writes one file for each event from it: @NAME@, @EVENT@
# and @CEL@ are replaced, and the lines between "@pull_request {" and
# "@pull_request }" are kept only for pull requests.
#
# Both runs start for every pull request and every master push, so the
# required check always reports; scripts/ci/stages.sh decides which stages a
# change needs. Don't add a pathChanged() filter here: a pull request it skips
# never reports the required check and can't merge.
#
# There is no cancel-in-progress annotation: Pipelines-as-Code rejects it on a
# Repository with a concurrency limit, so a superseded pull request run runs
# to the end.
#
# No task reads the per-run GitHub token Pipelines-as-Code offers: CI has no
# GitHub credentials. Results go to the check run Pipelines-as-Code posts and the
# step log.
#
# The pipeline is inline: Tasks come only from ci-tekton through the cluster
# resolver.
apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  # A fixed name collides with the previous run, which Pipelines-as-Code keeps.
  # The check run is named "Tekton CI / {{PROJECT}}-@NAME@-" after this.
  generateName: {{PROJECT}}-@NAME@-
  annotations:
    pipelinesascode.tekton.dev/on-cel-expression: >-
      @CEL@
    pipelinesascode.tekton.dev/max-keep-runs: "10"
spec:
  params:
    - name: repo_url
      value: "{{ repo_url }}"
    - name: revision
      value: "{{ revision }}"
  timeouts:
    pipeline: 1h
  workspaces:
    # Shared by the step and dockerd at the same path, so stage containers
    # can mount the checkout.
    - name: source
      emptyDir: {}
  taskRunSpecs:
    # Every stage runs inside the dind sidecar's cgroup, so its memory is the
    # memory of all stages together. Kata VMs need request == limit. Start at
    # 4Gi and resize to max(4 GiB, 1.5 times the measured peak; the end of the
    # step log prints it, page cache excluded). No CPU limit: a kata VM's CPU
    # request only places the pod and sets its share.
    - pipelineTaskName: ci
      sidecarSpecs:
        - name: dind
          computeResources:
            requests:
              cpu: "4"
              memory: 4Gi
            limits:
              memory: 4Gi
      stepSpecs:
        - name: run
          computeResources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              memory: 256Mi
  pipelineSpec:
    params:
      - name: repo_url
        type: string
      - name: revision
        type: string
    workspaces:
      - name: source
    tasks:
      - name: ci
        taskRef:
          resolver: cluster
          params:
            - name: kind
              value: task
            - name: name
              value: docker
            - name: namespace
              value: ci-tekton
        params:
          - name: script
            value: |
              set -eu
              mkdir src
              cd src
              git init -q .
              git remote add origin "$(params.repo_url)"
              # master too: the stage selection diffs against the merge base.
              git fetch -q origin '+refs/heads/master:refs/remotes/origin/master' "$(params.revision)"
              git checkout -q --detach "$(params.revision)"
#@pull_request {
              # Test the PR merged with master, as actions/checkout does.
              if ! git -c user.email=ci@ci -c user.name=ci merge -q --no-ff --no-edit origin/master; then
                echo "the pull request conflicts with master; rebase it:" >&2
                git diff --name-only --diff-filter=U >&2
                exit 1
              fi
#@pull_request }
              exec ./scripts/ci/stages.sh @EVENT@
        workspaces:
          - name: source
            workspace: source
