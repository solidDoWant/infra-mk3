{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Base: managers (flux / kubernetes / kustomize across all YAML),
  // `# renovate:` annotations, oci:// refs, commit format.
  // Policy (limits, grouping, automerge, approvals) lives below.
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    ":semanticCommits",
    ":timezone(America/Chicago)",
  ],

  // The preset disables rate limiting. Without CI every merge is a deploy, so
  // cap the backlog instead of opening ~200 PRs at once.
  // prConcurrentLimit: 10,
  // prHourlyLimit: 4,
  // Hold new releases briefly (supply-chain safety, chained hotfix releases).
  // timestamp-optional: registries without release timestamps (many OCI
  // registries) would otherwise be held forever.
  minimumReleaseAge: "3 days",
  // cspell:words Behaviour
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // The resulting "did not have a releaseTimestamp, ... proceeding" WARNs are
  // the expected outcome of the above, but count as repository problems and
  // operator warnings. Per-dep detail stays at debug.
  logLevelRemap: [
    {
      matchMessage: "/did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional/",
      newLogLevel: "debug",
    },
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // Tags can be re-pushed; a digest pins the exact content. Digest-only
  // updates then also follow re-pushes of floating tags (latest, branches).
  pinDigests: true,

  // Replaces config:recommended's list, so the defaults are repeated.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/*.sops.*",
    ".claude/**",
    "**/docs/**",
    "schemas/**",
    "custom hardware/**",
    // Ad-hoc debug pods, not deployed by Flux.
    "cluster/tooling/**",
  ],

  // The flux manager already extracts HelmRelease values images; helm-values
  // would extract every hr.yaml image a second time.
  "helm-values": { enabled: false },
  // Off by default upstream. Locked flake inputs only move through
  // lockFileMaintenance (`nix flake update`, weekly by default).
  nix: { enabled: true, lockFileMaintenance: { enabled: true } },

  customDatasources: {
    "grafana-plugins": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/plugins/{{packageName}}/versions",
      format: "json",
      // Each version carries the plugin's GitHub repo; sourceUrl drives changelog fetching.
      transformTemplates: [
        '{"releases": $map(items, function($i) { {"version": $i.version, "releaseTimestamp": $i.createdAt} }), "sourceUrl": items[0].url}',
      ],
    },
    // Directory index of the installer ISOs; every link is a release candidate,
    // extractVersion (packageRules) keeps the proxmox-ve_X.Y-Z.iso ones.
    "proxmox-iso": {
      defaultRegistryUrlTemplate: "https://enterprise.proxmox.com/iso/",
      format: "html",
    },
  },

  customManagers: [
    {
      customType: "regex",
      description: "GitHub release assets and tagged raw files (CRDs, manifests, dashboards, schemas)",
      managerFilePatterns: ["/^cluster/.+\\.ya?ml$/"],
      matchStrings: [
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/releases/download/(?<currentValue>v?\\d[^/\\s]*)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "VPA CRDs, tagged vertical-pod-autoscaler-X.Y.Z in the kubernetes/autoscaler monorepo",
      managerFilePatterns: ["/^cluster/.+\\.ya?ml$/"],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/kubernetes/autoscaler/refs/tags/vertical-pod-autoscaler-(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
      ],
      depNameTemplate: "kubernetes/autoscaler",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Talos config $schema URLs, versioned by minor: tracked as siderolabs/talos so they join the talos group PR",
      managerFilePatterns: ["/^talos/.+\\.ya?ml(?:\\.tpl)?$/"],
      matchStrings: [
        "\\$schema=https://docs\\.siderolabs\\.com/talos/(?<currentValue>v\\d+\\.\\d+)/schemas/",
      ],
      depNameTemplate: "siderolabs/talos",
      datasourceTemplate: "custom.talos-factory",
      // Collapse vX.Y.Z releases to vX.Y; prereleases don't match and are dropped.
      extractVersionTemplate: "^(?<version>v\\d+\\.\\d+)\\.\\d+$",
      versioningTemplate: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)$",
    },
    {
      customType: "regex",
      description: "Kyverno dashboard, tagged kyverno-chart-X.Y.Z: tracked as the kyverno chart so it follows the chart pin",
      managerFilePatterns: ["/^cluster/.+\\.ya?ml$/"],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/kyverno/kyverno/refs/tags/kyverno-chart-(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
      ],
      depNameTemplate: "kyverno",
      datasourceTemplate: "helm",
      registryUrlTemplate: "https://kyverno.github.io/kyverno",
    },
    {
      customType: "regex",
      description: "Grafana plugins (grafana-operator plugins: lists)",
      managerFilePatterns: ["/^cluster/.+\\.ya?ml$/"],
      matchStrings: [
        "- name: (?<depName>[a-z0-9]+(?:-[a-z0-9]+)*-(?:datasource|panel|app))\\n\\s+version: [\"']?(?<currentValue>\\d[^\"'\\s]*)",
      ],
      datasourceTemplate: "custom.grafana-plugins",
    },
    {
      customType: "regex",
      description: "tape-archiver data-worker image deployed by Ansible",
      managerFilePatterns: ["/^ansible/.+\\.ya?ml$/"],
      matchStrings: [
        "(?<depName>ghcr\\.io/soliddowant/tape-archiver/[a-z0-9-]+):(?<currentValue>[\\w.-]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Literal image refs assigned to *_IMAGE Makefile variables",
      managerFilePatterns: ["/(^|/)Makefile$/"],
      matchStrings: [
        "(?:^|\\n)\\w*_IMAGE\\s*[?:]?=\\s*(?<depName>[a-z0-9][\\w./-]*):(?<currentValue>\\w[\\w.-]*)\\s*(?:\\n|$)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Literal image refs assigned to *_IMAGE Taskfile vars",
      managerFilePatterns: ["/^\\.taskfiles/.+\\.ya?ml$/"],
      matchStrings: [
        "\\w*_IMAGE:\\s*[\"']?(?<depName>[a-z0-9][\\w./-]*):(?<currentValue>\\w[\\w.-]*)[\"']?\\s*(?:\\n|$)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "`# renovate: datasource=… depName=…` annotations on `KEY = value` lines (Makefile, Nix); the preset's annotation manager needs `=` directly before the value",
      managerFilePatterns: ["/(^|/)Makefile$/", "/\\.nix$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*?\\s=\\s*[\"']?(?<currentValue>[^\"'\\s;]+)[\"']?",
      ],
    },
    {
      customType: "regex",
      description: "Commit pins following a GitHub branch: `# renovate: datasource=git-refs depName=<owner>/<repo> branch=<branch>` above the full SHA",
      managerFilePatterns: ["/^ansible/.+\\.ya?ml$/", "/\\.nix$/"],
      matchStrings: [
        "datasource=git-refs depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n[^\\n]*?(?::\\s*|=\\s*)[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?",
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{{depName}}}",
    },
    {
      customType: "regex",
      description: "Kustomize remote git bases pinned by commit: `//<path>?…ref=<sha> # <tag>`",
      managerFilePatterns: ["/(^|/)kustomization\\.ya?ml$/"],
      matchStrings: [
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)//[^?\\s]*\\?(?:[^\\s#]*&)?ref=(?<currentDigest>[0-9a-f]{40})[^\\s#]*\\s+#\\s*(?<currentValue>v?\\d\\S*)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "`# renovate: image` above a digest-pinned image ref the built-in managers don't see (env vars, args, operator config)",
      managerFilePatterns: ["/^cluster/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: image\\n[^\\n]*?[\\s\"'=](?<depName>[a-z0-9][\\w.-]*(?::\\d+)?/[\\w./-]+):(?<currentValue>\\w[\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Image maps the flux manager can't see: full repo in `registry:` (democratic-csi) or under a parent key not named `image` (KEDA)",
      managerFilePatterns: ["/^cluster/gitops/storage/democratic-csi/.+\\.ya?ml$/", "/^cluster/gitops/system-controllers/keda/app/hr\\.yaml$/"],
      matchStrings: [
        "(?:registry|repository): (?<depName>[a-z0-9][\\w.-]*/[\\w./-]+)\\n\\s*tag: (?<currentValue>\\w[\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Tagged raw files (CRDs, manifests, dashboards, values schema refs)",
      managerFilePatterns: ["/^cluster/.+\\.(ya?ml|json)$/"],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/(?:refs/tags/)?(?<currentValue>v\\d[^/\\s]*)/",
        "https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/raw/refs/tags/(?<currentValue>v\\d[^/\\s]*)/",
      ],
      datasourceTemplate: "github-tags",
    },
  ],

  packageRules: [
    // --- Approval / safety ---------------------------------------------------
    {
      description: "Major updates wait for a Dependency Dashboard checkbox",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Images built and pushed by CI to the in-cluster Harbor; the repo only holds the unsubstituted host",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^harbor\\./"],
      enabled: false,
    },
    {
      description: "No digest pins: flake.lock already pins nixpkgs, and a preset ref can't carry both tag and SHA",
      matchManagers: ["nix", "renovate-config"],
      pinDigests: false,
    },
    {
      description: "Remote git bases are tracked by the commit-pin regex manager; the kustomize manager would read the SHA as the version",
      matchManagers: ["kustomize"],
      matchDatasources: ["github-tags", "git-tags"],
      enabled: false,
    },
    {
      description: "Inline image strings in HelmRelease values are already extracted by the flux manager",
      matchManagers: ["kubernetes"],
      matchFileNames: ["**/hr.yaml"],
      enabled: false,
    },
    {
      description: "Envoy publishes contrib-/distroless- variants as separate tag streams",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^(docker\\.io/)?envoyproxy/envoy$/"],
      versioning: "regex:^(?:(?<compatibility>contrib|distroless)-)?v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "Ubuntu: numeric LTS tags only (ubuntu versioning also treats codenames like 'resolute' as versions)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ubuntu", "docker.io/library/ubuntu"],
      allowedVersions: "/^\\d[02468]\\.04$/",
    },
    {
      description: "Images tagged by Ubuntu release: LTS only. devcontainers dropped the dash from 26.04 on",
      matchDatasources: ["docker"],
      matchPackageNames: ["mcr.microsoft.com/devcontainers/base", "ghcr.io/gameservermanagers/steamcmd"],
      versioning: "regex:^ubuntu-?(?<major>\\d+)\\.(?<minor>\\d+)$",
      allowedVersions: "/^ubuntu-?\\d[02468]\\.04$/",
    },
    {
      // Rook flags data corruption in Tentacle 20.2.0 with csi.readAffinity on
      // (enabled here): take Tentacle at >= 20.2.2.
      description: "Ceph: X.0.Z is dev and X.1.Z is RC, so only X.2.0+ is stable. One PR per major",
      matchDatasources: ["docker"],
      matchPackageNames: ["/(^|/)ceph/ceph$/"],
      allowedVersions: "/^v\\d+\\.([2-9]|\\d{2,})\\.\\d+$/",
      separateMultipleMajor: true,
    },
    {
      description: "kubernetes/autoscaler is a monorepo; VPA releases are tagged vertical-pod-autoscaler-X.Y.Z",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["kubernetes/autoscaler"],
      extractVersion: "^vertical-pod-autoscaler-(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      description: "VictoriaLogs tags dropped the -victorialogs suffix after v1.17.0",
      matchDatasources: ["docker"],
      matchPackageNames: ["victoriametrics/victoria-logs"],
      versioning: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-victorialogs)?$",
    },
    {
      description: "Release tags are vX.Y.Z; the Ansible/Nix vars are bare",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["prometheus-community/smartctl_exporter", "coder/coder"],
      extractVersion: "^v(?<version>.+)$",
    },
    {
      description: "OPNsense: an installer ISO only exists for the YY.1/YY.7 releases (no patch, beta or RC builds)",
      matchDatasources: ["github-tags"],
      matchPackageNames: ["opnsense/core"],
      allowedVersions: "/^\\d+\\.[17]$/",
    },
    {
      description: "Proxmox VE installer ISOs: proxmox-ve_X.Y-Z.iso (amd64 only)",
      matchDatasources: ["custom.proxmox-iso"],
      extractVersion: "^(?:\\./)?proxmox-ve_(?<version>\\d+\\.\\d+-\\d+)\\.iso$",
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)$",
    },
    {
      description: "Nix fixed-output hashes sit next to the bumped version and are not updated",
      matchFileNames: ["**/*.nix"],
      prBodyNotes: [
        "⚠️ Update the `hash`/`*Hash` values next to the bumped Nix version: set them to `lib.fakeHash` and take the `got:` value from the build error.",
      ],
    },
    {
      description: "mhvtl: the DKMS package version is the module's MHVTL_VERSION and gates the DKMS rebuild",
      matchPackageNames: ["markh794/mhvtl"],
      prBodyNotes: [
        "⚠️ Bump `mhvtl_pkg_version` to the new commit's `MHVTL_VERSION` in `kernel/mhvtl.c` (not the spec `Version`). The DKMS install is skipped while `dkms status` reports the old package version as installed, so a commit bump alone does not rebuild the module.",
      ],
    },
    {
      description: "charts-mirror is a stop-gap: it prunes a chart 6 months after upstream publishes an official OCI chart",
      matchPackageNames: ["/^ghcr\\.io/home-operations/charts-mirror//"],
      prBodyNotes: [
        "⚠️ Mirrored chart. Check whether upstream now publishes an official OCI chart (https://github.com/home-operations/charts-mirror/issues/8) and switch the OCIRepository `url` to it.",
      ],
    },
    {
      description: "Kyverno chart pinned (see kyverno/app/hr.yaml): 3.6.3+ breaks service: apiCall contexts until kyverno/kyverno#16047 ships",
      matchPackageNames: ["kyverno", "ghcr.io/kyverno/charts/kyverno"],
      allowedVersions: "/^3\\.6\\.[0-2]$/",
    },
    {
      description: "Kyverno images: the app versions of the pinned 3.6.0-3.6.2 charts",
      matchPackageNames: ["/^reg\\.kyverno\\.io/kyverno//"],
      allowedVersions: "/^v1\\.16\\.[0-2]$/",
    },
    {
      description: "mail 5.0.0-5.1.0 crash with metrics enabled (sed -i on the subPath-mounted logrotate.conf, bokysan/docker-postfix#278); fix #266 is unreleased",
      matchDatasources: ["helm"],
      matchPackageNames: ["mail"],
      allowedVersions: "!/^v?5\\.(0\\.[01]|1\\.0)$/",
    },
    {
      description: "postfix image: same hold as the mail chart (chart and image versions match)",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/boky/postfix"],
      allowedVersions: "!/^v?5\\.(0\\.[01]|1\\.0)$/",
    },
    {
      description: "VM operator config-reloader tags: config-reloader-vX.Y.Z, released with the operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/victoriametrics/operator"],
      matchCurrentValue: "/^config-reloader-/",
      versioning: "regex:^config-reloader-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "smartctl-exporter 0.15.0 skipped (closed #128/#188/#195); the group PR is immortal, so closing it does not stick",
      matchPackageNames: ["prometheus-community/smartctl_exporter", "quay.io/prometheuscommunity/smartctl-exporter"],
      allowedVersions: "!/^v?0\\.15\\.0$/",
    },
    {
      description: "Kubernetes may not outrun what the deployed Talos supports; raise alongside Talos upgrades",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      allowedVersions: "<1.37",
    },

    // --- Groups (one PR for components that must move together) ------------
    {
      description: "Talos: topf.yaml + talosctl",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talosctl"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Flux: install manifests + CLI",
      groupName: "flux",
      matchPackageNames: ["fluxcd/flux2", "ghcr.io/fluxcd/flux-cli", "/^ghcr\\.io/fluxcd/(source|kustomize|helm|notification)-controller$/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Rook: operator + cluster charts, operator image, bundled ceph-csi-operator and the drivers chart that must match it",
      groupName: "rook-ceph",
      matchPackageNames: [
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
        "docker.io/rook/ceph",
        "quay.io/cephcsi/ceph-csi-operator",
        "ghcr.io/home-operations/charts-mirror/ceph-csi-drivers",
      ],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Istio: charts + images + istioctl",
      groupName: "istio",
      matchPackageNames: ["/^gcr\\.io/istio-release/charts//", "/^registry\\.istio\\.io/release//", "istio/istioctl"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    // CRDs applied from release assets must move with their operator.
    {
      description: "spegel: HelmRelease + bootstrap helmfile chart, dashboard URL tag",
      groupName: "spegel",
      matchPackageNames: ["spegel", "ghcr.io/spegel-org/helm-charts/spegel", "spegel-org/spegel"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "CoreDNS: HelmReleases + bootstrap helmfile chart (depNames differ: full OCI path vs helmfile release chart)",
      groupName: "coredns",
      matchPackageNames: ["ghcr.io/coredns/charts/coredns"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "kubelet-csr-approver: HelmRelease + bootstrap helmfile chart (depNames differ: full OCI path vs helmfile release chart)",
      groupName: "kubelet-csr-approver",
      matchPackageNames: ["ghcr.io/postfinance/charts/kubelet-csr-approver", "ghcr.io/postfinance/kubelet-csr-approver"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Teleport: charts, tbot sidecars (must not outrun the cluster), chart schema refs, devcontainer + VM workspace binaries",
      groupName: "teleport",
      matchPackageNames: ["/^teleport-/", "/gravitational\\/(tbot|teleport)-distroless$/", "gravitational/teleport"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "VictoriaMetrics: k8s-stack chart (bundles the operator) + operator CRDs + the metrics datasource plugin it configures",
      groupName: "victoria-metrics-operator",
      matchPackageNames: ["/victoria-metrics-k8s-stack$/", "VictoriaMetrics/operator", "victoriametrics-metrics-datasource"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "VictoriaMetrics: regenerate the k8s-stack chart's vendored rules and dashboards",
      matchPackageNames: ["/victoria-metrics-k8s-stack$/"],
      postUpgradeTasks: {
        commands: ["go -C cluster/gitops/monitoring/victoria-metrics/sync-job/tool run ."],
        fileFilters: ["cluster/gitops/monitoring/victoria-metrics/sync-job/generated/**"],
        installTools: { golang: {}, helm: {} },
      },
    },
    {
      description: "VictoriaLogs + its Grafana datasource plugin",
      groupName: "victoria-logs",
      matchPackageNames: ["victoriametrics/victoria-logs", "victoriametrics-logs-datasource"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Keep the 0.x plugin on the victoria-logs group branch (the preset routes 0.x minors to major- branches)",
      matchPackageNames: ["victoriametrics-logs-datasource"],
      additionalBranchPrefix: "",
    },
    {
      description: "Kyverno chart + dashboard (same chart version) + images",
      groupName: "kyverno",
      matchPackageNames: ["kyverno", "ghcr.io/kyverno/charts/kyverno", "/^reg\\.kyverno\\.io/kyverno//"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Cilium: chart (HelmRelease + bootstrap helmfile) + values schema ref + CLI in the devcontainer",
      groupName: "cilium",
      matchPackageNames: ["/(^|/)cilium$/", "cilium/cilium-cli"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "cert-manager: chart + images + cmctl in the devcontainer",
      groupName: "cert-manager",
      matchPackageNames: [
        "quay.io/jetstack/charts/cert-manager",
        "/^quay\\.io/jetstack/cert-manager-(controller|webhook|cainjector|acmesolver|startupapicheck)$/",
        "cert-manager/cmctl",
      ],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Helm tooling in the devcontainer: helm, helmfile and the plugins helmfile requires",
      groupName: "helm-tooling",
      matchPackageNames: ["alpine/helm", "ghcr.io/helmfile/helmfile", "databus23/helm-diff"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Goldilocks: chart + image tag override",
      groupName: "goldilocks",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/goldilocks", "us-docker.pkg.dev/fairwinds-ops/oss/goldilocks"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Keep 0.x members on their group branch (the preset routes 0.x minors to major- branches)",
      matchPackageNames: ["cilium/cilium-cli", "victoriametrics-metrics-datasource"],
      additionalBranchPrefix: "",
    },
    // Exporter/app image + the dashboard pinned to the same release.
    {
      groupName: "qbittorrent-exporter",
      matchPackageNames: ["ghcr.io/martabal/qbittorrent-exporter", "martabal/qbittorrent-exporter"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "nginx-prometheus-exporter",
      matchPackageNames: ["ghcr.io/nginx/nginx-prometheus-exporter", "nginx/nginx-prometheus-exporter"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "backup-tool: dr-job chart + the image its consumers pin (which the pods it starts also run)",
      groupName: "backup-tool",
      matchPackageNames: ["ghcr.io/soliddowant/charts/dr-job", "ghcr.io/soliddowant/backup-tool"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "media-processor",
      matchPackageNames: ["/(^|/)media-processor$/", "/^ghcr\\.io/soliddowant/media-processor//", "solidDoWant/media-processor"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "smartctl-exporter",
      matchPackageNames: ["prometheus-community/smartctl_exporter", "quay.io/prometheuscommunity/smartctl-exporter"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "tape-archiver: charts + the Ansible-deployed data-worker image",
      groupName: "tape-archiver",
      matchPackageNames: ["/(^|/)tape-archiver-(web|control-worker)$/", "/^ghcr\\.io/soliddowant/tape-archiver//"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Coder: chart + CLI image in the devcontainer + agent in the VM workspace image",
      groupName: "coder",
      matchPackageNames: ["ghcr.io/coder/chart/coder", "ghcr.io/coder/coder", "coder/coder"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "VPA: Fairwinds chart + recommender image + CRDs (kubernetes/autoscaler)",
      groupName: "vpa",
      matchPackageNames: ["vpa", "kubernetes/autoscaler", "registry.k8s.io/autoscaling/vpa-recommender"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "KEDA: chart + CRD kustomize base",
      groupName: "keda",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/keda", "kedacore/keda", "/^ghcr\\.io/kedacore/keda(-admission-webhooks)?$/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "grafana-operator",
      matchPackageNames: ["/grafana-operator/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "system-upgrade-controller",
      matchPackageNames: ["/system-upgrade-controller/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "node-network-operator",
      matchPackageNames: ["/node-network-operator/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "whereabouts",
      matchPackageNames: ["/whereabouts/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "kubevirt",
      matchPackageNames: ["/kubevirt/", "/containerized-data-importer/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "democratic-csi: chart + driver image (image tag sits in the chart's image map)",
      groupName: "democratic-csi",
      matchPackageNames: ["ghcr.io/democratic-csi/charts/democratic-csi", "ghcr.io/democratic-csi/democratic-csi"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Keep the 0.x chart on the democratic-csi group branch (the preset routes 0.x minors to major- branches)",
      matchPackageNames: ["ghcr.io/democratic-csi/charts/democratic-csi"],
      additionalBranchPrefix: "",
    },
    {
      groupName: "rabbitmq",
      matchPackageNames: ["/rabbitmq/", "/messaging-topology-operator/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Ubuntu: base image + images tagged by Ubuntu release",
      groupName: "ubuntu",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ubuntu",
        "docker.io/library/ubuntu",
        "mcr.microsoft.com/devcontainers/base",
        "ghcr.io/gameservermanagers/steamcmd",
      ],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Envoy: same image referenced with and without the docker.io prefix",
      groupName: "envoy",
      matchPackageNames: ["/^(docker\\.io/)?envoyproxy/envoy$/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Temporal: chart + server/admin-tools/ui images",
      groupName: "temporal",
      matchPackageNames: ["temporal", "/^temporalio\\//"],
      matchDatasources: ["helm", "docker"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "fluent-operator: operator + CRD charts + the fluent-bit/fluentd images it renders",
      groupName: "fluent-operator",
      matchPackageNames: ["/^ghcr\\.io/fluent/helm-charts/fluent-operator/", "/^ghcr\\.io/fluent/fluent-operator//"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "Volume snapshots: CRDs + snapshot-controller chart",
      groupName: "volume-snapshot",
      matchPackageNames: [
        "kubernetes-csi/external-snapshotter",
        "ghcr.io/piraeusdatastore/helm-charts/snapshot-controller",
        "registry.k8s.io/sig-storage/snapshot-controller",
      ],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    // Chart + the images it would default to, pinned in values so they carry a
    // digest. Overrides stop following the chart, so they share its PR.
    // Images shared across charts at different versions are scoped by file.
    {
      description: "VictoriaMetrics: images pinned in the k8s-stack values",
      groupName: "victoria-metrics-operator",
      matchFileNames: ["cluster/gitops/monitoring/victoria-metrics/k8s-stack/**"],
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/^docker\\.io/victoriametrics//",
        "docker.io/prom/alertmanager",
        "registry.k8s.io/kube-state-metrics/kube-state-metrics",
        "quay.io/prometheus/node-exporter",
      ],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "ceph-csi: plugin + sidecars the drivers run (the operator's defaults for its version)",
      groupName: "rook-ceph",
      matchFileNames: ["cluster/gitops/storage/rook-ceph/**"],
      matchPackageNames: ["quay.io/cephcsi/cephcsi", "/^registry\\.k8s\\.io/sig-storage//"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      description: "democratic-csi: sidecars, proxy and init images",
      groupName: "democratic-csi",
      matchFileNames: ["cluster/gitops/storage/democratic-csi/**"],
      matchPackageNames: ["ghcr.io/democratic-csi/csi-grpc-proxy", "docker.io/busybox", "/^registry\\.k8s\\.io/sig-storage//"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "openebs",
      matchFileNames: ["cluster/gitops/storage/openebs/**"],
      matchPackageNames: ["ghcr.io/openebs/charts/openebs", "ghcr.io/openebs/zfs-driver", "/^registry\\.k8s\\.io/sig-storage//"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "cloudnative-pg",
      matchPackageNames: ["ghcr.io/cloudnative-pg/charts/cloudnative-pg", "ghcr.io/cloudnative-pg/cloudnative-pg", "ghcr.io/cloudnative-pg/pgbouncer"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "plugin-barman-cloud",
      matchPackageNames: ["/^ghcr\\.io/cloudnative-pg/(charts/)?plugin-barman-cloud(-sidecar)?$/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "dragonfly-operator",
      matchPackageNames: ["ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator", "docker.dragonflydb.io/dragonflydb/operator"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "approver-policy",
      matchPackageNames: ["/^quay\\.io/jetstack/(charts/)?cert-manager-approver-policy$/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "istio-csr",
      matchPackageNames: ["/^quay\\.io/jetstack/(charts/)?cert-manager-istio-csr$/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "kiali",
      matchPackageNames: ["kiali-server", "quay.io/kiali/kiali"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "k8tz",
      matchPackageNames: ["ghcr.io/k8tz/k8tz/charts/k8tz", "quay.io/k8tz/k8tz"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "node-feature-discovery",
      matchPackageNames: ["/^registry\\.k8s\\.io/nfd/(charts/)?node-feature-discovery$/"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "descheduler",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/descheduler", "registry.k8s.io/descheduler/descheduler"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "metrics-server",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/metrics-server", "registry.k8s.io/metrics-server/metrics-server"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "external-dns",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/external-dns", "registry.k8s.io/external-dns/external-dns"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "amd-gpu-dra-driver",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/k8s-gpu-dra-driver", "docker.io/rocm/k8s-gpu-dra-driver"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "harbor",
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/harbor", "/^docker\\.io/goharbor//"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "authentik",
      matchPackageNames: ["ghcr.io/goauthentik/helm-charts/authentik", "ghcr.io/goauthentik/server"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "mail",
      matchPackageNames: ["mail", "docker.io/boky/postfix", "docker.io/boky/postfix-exporter"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "renovate-operator",
      matchPackageNames: ["ghcr.io/mogenius/helm-charts/renovate-operator", "ghcr.io/mogenius/renovate-operator"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },
    {
      groupName: "crd-schema-publisher",
      matchPackageNames: ["ghcr.io/sholdee/charts/crd-schema-publisher", "ghcr.io/sholdee/crd-schema-publisher"],
      group: { commitMessageTopic: "{{{groupName}}} group" },
    },

    // --- Changelog sources ---------------------------------------------------
    // Release notes come from GitHub releases/tags of sourceUrl. Packages with
    // no (or a wrong) org.opencontainers.image.source label get one here;
    // changelogUrl is a link-only fallback where upstream tags don't match.
    {
      matchPackageNames: ["registry.k8s.io/kubectl"],
      sourceUrl: "https://github.com/kubernetes/kubernetes",
    },
    {
      matchPackageNames: ["/dragonfly-operator/"],
      sourceUrl: "https://github.com/dragonflydb/dragonfly-operator",
    },
    {
      matchPackageNames: ["ghcr.io/dragonflydb/dragonfly"],
      sourceUrl: "https://github.com/dragonflydb/dragonfly",
    },
    {
      matchPackageNames: ["public.ecr.aws/aws-cli/aws-cli"],
      sourceUrl: "https://github.com/aws/aws-cli",
    },
    {
      matchPackageNames: ["/^(docker\\.io/)?democraticcsi/democratic-csi$/", "ghcr.io/democratic-csi/democratic-csi"],
      sourceUrl: "https://github.com/democratic-csi/democratic-csi",
    },
    {
      matchPackageNames: ["ghcr.io/grpc-ecosystem/grpc-health-probe"],
      sourceUrl: "https://github.com/grpc-ecosystem/grpc-health-probe",
    },
    {
      matchPackageNames: ["ghcr.io/k8s-gateway/k8s_gateway"],
      sourceUrl: "https://github.com/k8s-gateway/k8s_gateway",
    },
    {
      matchPackageNames: ["ghcr.io/fluent/fluent-operator/fluent-bit"],
      sourceUrl: "https://github.com/fluent/fluent-bit",
    },
    {
      matchPackageNames: ["ghcr.io/jellyfin/jellyfin"],
      sourceUrl: "https://github.com/jellyfin/jellyfin",
    },
    {
      description: "Tags track the bundled kubectl version",
      matchPackageNames: ["alpine/k8s"],
      sourceUrl: "https://github.com/kubernetes/kubernetes",
    },
    {
      description: "Tags track the bundled helm version",
      matchPackageNames: ["alpine/helm"],
      sourceUrl: "https://github.com/helm/helm",
    },
    {
      matchPackageNames: ["quay.io/prometheuscommunity/smartctl-exporter"],
      sourceUrl: "https://github.com/prometheus-community/smartctl_exporter",
    },
    {
      matchDatasources: ["pypi"],
      matchPackageNames: ["omsdk"],
      sourceUrl: "https://github.com/dell/omsdk",
    },
    {
      description: "Changelog lives in the README",
      matchDatasources: ["pypi"],
      matchPackageNames: ["bcrypt"],
      changelogUrl: "https://github.com/pyca/bcrypt#changelog",
    },
    {
      description: "Tags are vX.Y; images are X.Y.Z",
      matchPackageNames: ["ghcr.io/home-operations/nzbget"],
      changelogUrl: "https://github.com/nzbgetcom/nzbget/releases",
    },
    {
      description: "Floating X.Y tags don't match vX.Y.Z releases",
      matchPackageNames: ["hashicorp/terraform"],
      changelogUrl: "https://github.com/hashicorp/terraform/releases",
    },
    {
      description: "Tags are gpu-vX.Y.Z; release notes fall back to extractVersion for tag matching",
      matchPackageNames: ["/intel-gpu-resource-driver/"],
      extractVersion: "^(?:gpu-v)?(?<version>.+)$",
    },
    {
      description: "talos-factory custom datasource (talosFactory preset) has no source",
      matchDatasources: ["custom.talos-factory"],
      sourceUrl: "https://github.com/siderolabs/talos",
    },
    // Coder registry modules: monorepo tagged release/coder/<module>/vX.Y.Z.
    // extractVersion is per module so sibling modules' tags can't match.
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["/^registry\\.coder\\.com/coder//"],
      sourceUrl: "https://github.com/coder/registry",
    },
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["registry.coder.com/coder/claude-code/coder"],
      extractVersion: "^(?:release/coder/claude-code/v)?(?<version>\\d.*)$",
    },
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["registry.coder.com/coder/git-commit-signing/coder"],
      extractVersion: "^(?:release/coder/git-commit-signing/v)?(?<version>\\d.*)$",
    },
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["registry.coder.com/coder/agentapi/coder"],
      extractVersion: "^(?:release/coder/agentapi/v)?(?<version>\\d.*)$",
    },
    // Monorepo chart tags (<chart>-helm-chart-X.Y.Z) don't match; link the chart changelog.
    {
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/external-dns"],
      changelogUrl: "https://github.com/kubernetes-sigs/external-dns/blob/master/charts/external-dns/CHANGELOG.md",
    },
    {
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/metrics-server"],
      changelogUrl: "https://github.com/kubernetes-sigs/metrics-server/blob/master/charts/metrics-server/CHANGELOG.md",
    },
    {
      description: "Teleport's GitHub releases lag its charts/images",
      matchPackageNames: ["/^teleport-/", "/gravitational\\/(tbot|teleport)/"],
      changelogUrl: "https://goteleport.com/docs/changelog/",
    },
    {
      matchPackageNames: ["registry.k8s.io/pause"],
      changelogUrl: "https://github.com/kubernetes/kubernetes/blob/master/build/pause/CHANGELOG.md",
    },
    {
      description: "Tags are kustomize/vX.Y.Z",
      matchPackageNames: ["registry.k8s.io/kustomize/kustomize"],
      changelogUrl: "https://github.com/kubernetes-sigs/kustomize/releases",
    },
    {
      description: "contrib-/distroless- tags don't match envoy's vX.Y.Z releases",
      matchPackageNames: ["/^(docker\\.io/)?envoyproxy/envoy$/"],
      changelogUrl: "https://github.com/envoyproxy/envoy/releases",
    },
    {
      matchPackageNames: ["python", "docker.io/library/python"],
      changelogUrl: "https://docs.python.org/3/whatsnew/changelog.html",
    },
    {
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      changelogUrl: "https://www.postgresql.org/docs/release/",
    },
    {
      matchPackageNames: ["alpine/curl"],
      changelogUrl: "https://curl.se/changes.html",
    },
    // FairwindsOps/charts has no tags/releases; the chart dir history is the changelog.
    {
      matchDatasources: ["helm"],
      matchPackageNames: ["vpa"],
      changelogUrl: "https://github.com/FairwindsOps/charts/commits/master/stable/vpa",
    },
    {
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/goldilocks"],
      changelogUrl: "https://github.com/FairwindsOps/charts/commits/master/stable/goldilocks",
    },

    // --- Labels -----------------------------------------------------------
    // Update-type labels use `labels` (last match wins) so a later rule can
    // relabel; other labels use `addLabels` and accumulate on top.
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest", "pinDigest"],
      labels: ["type/digest"],
    },
    // After the update-type labels so `labels` overrides type/minor.
    {
      description: "Kubernetes, Talos and Rook/Ceph minors are their breaking releases: handle them as majors",
      matchUpdateTypes: ["minor"],
      matchPackageNames: [
        // Kubernetes
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kubectl",
        "alpine/k8s",
        // Talos
        "siderolabs/talos",
        "ghcr.io/siderolabs/talosctl",
        "ghcr.io/siderolabs/installer",
        // Rook/Ceph
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
        "/(^|/)ceph/ceph$/",
        // Each minor adds CRD fields and must match the ceph-csi-operator
        // subchart bundled by rook-ceph (rook 1.20 -> 1.0.x, 1.21 -> 1.1.x).
        // Bump it by hand in the Rook minor PR. Patches are backports only.
        "ghcr.io/home-operations/charts-mirror/ceph-csi-drivers",
      ],
      dependencyDashboardApproval: true,
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      additionalBranchPrefix: "major-",
      labels: ["type/major"],
    },
    // Without separateMinorPatch the latest minor (a major here) supersedes
    // the patch, so no patch PR is opened. No matchUpdateTypes: Renovate
    // reads this flag before update types are known.
    {
      description: "Talos and ceph-csi-drivers patches get their own PR",
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/talosctl",
        "ghcr.io/siderolabs/installer",
        "ghcr.io/home-operations/charts-mirror/ceph-csi-drivers",
      ],
      separateMinorPatch: true,
    },
    // Kubernetes and Rook upgrades step through every minor on its latest
    // patch, so each minor needs its own PR (merge them in order).
    {
      description: "Kubernetes and Rook patches and each minor get their own PR",
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kubectl",
        "alpine/k8s",
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
      ],
      separateMinorPatch: true,
      separateMultipleMinor: true,
    },
    {
      description: "Kubernetes, Talos and Rook patches carry minor-sized changes: handle them as minors",
      matchUpdateTypes: ["patch"],
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kubectl",
        "alpine/k8s",
        "siderolabs/talos",
        "ghcr.io/siderolabs/talosctl",
        "ghcr.io/siderolabs/installer",
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
      ],
      semanticCommitType: "feat",
      labels: ["type/minor"],
    },
    // OCI charts use the docker datasource; tell them apart by path.
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["!/(^|[/-])(charts?|charts-mirror|helm|helm-charts)\\//", "!ghcr.io/rook/rook-ceph", "!ghcr.io/rook/rook-ceph-cluster", "!ghcr.io/intel/intel-gpu-resource-driver-chart"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["/(^|[/-])(charts?|charts-mirror|helm|helm-charts)\\//", "ghcr.io/rook/rook-ceph", "ghcr.io/rook/rook-ceph-cluster", "ghcr.io/intel/intel-gpu-resource-driver-chart"],
      addLabels: ["renovate/helm"],
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate/github-release"],
    },

    // Last so it overrides any preset rule: no CI, and merging deploys.
    {
      description: "Automerge disabled for everything",
      matchPackageNames: ["*"],
      automerge: false,
    },
  ],
}
