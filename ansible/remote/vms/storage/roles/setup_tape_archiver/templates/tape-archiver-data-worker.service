# {{ ansible_managed }}
#
# Runs the Nix-built data-worker OCI image directly via `docker run` with
# systemd as the SOLE supervisor: foreground (no `-d`), Type=simple, `--rm`.
# No docker-compose — a single container needs no orchestration, and a second
# supervisor would fight systemd over restarts. Adapted from the reference
# unit at deploy/data-worker/ in the tape-archiver repo, with one addition:
# the tbot JWT directory is bind-mounted for Temporal auth.

[Unit]
Description=tape-archiver data worker
Documentation=https://github.com/solidDoWant/tape-archiver/blob/master/docs/data-worker-image.md
Requires=docker.service
After=docker.service network-online.target tape-archiver-tbot.service
# After= here is a true readiness gate, not just process ordering: the tbot
# unit's ExecStartPost blocks its start job on tbot's /wait endpoint, which
# reports healthy only after the first JWT is written — so by the time this
# unit starts on a cold boot, /run/tape-archiver/jwt is populated.
# Wants (not Requires) tbot: the worker keeps running through a tbot restart —
# the JWT in /run/tape-archiver/jwt survives it (RuntimeDirectoryPreserve on
# the tbot unit) and stays valid until its next renewal regardless.
Wants=network-online.target tape-archiver-tbot.service
# A persistently broken host lands in `failed` instead of restarting forever
# (RestartSec alone keeps the default start limiter from ever tripping).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple

# Content-anchored image tag, pulled by ansible. --pull=never below means the
# unit never reaches out to a registry on start.
Environment=TAPE_ARCHIVER_IMAGE={{ tape_archiver_image }}

# Dry-run support: pass the mhvtl virtual library's devices through WHEN
# PRESENT, without making production depend on them. The generator resolves
# the stable /dev/mhvtl/* udev symlinks to their kernel nodes and maps each
# BOTH at its kernel path (so in-container sysfs walks stay consistent) and
# at its /dev/mhvtl/* path (the stable names dry-run configs use). If mhvtl
# is down/absent the env file is empty and the worker runs exactly as
# before. systemd re-reads EnvironmentFile before each Exec* process, so
# ExecStart sees what this pre-step wrote. ExecStart references the result as
# UNBRACED $MHVTL_DEVICE_FLAGS so systemd word-splits it into separate args
# (and an empty value expands to zero args); ${...} would pass one blob.
#
# Library mirroring (tape-archiver >= 0.0.10): before a dry run the worker
# rewrites the virtual library to mirror the REAL library's slot occupancy,
# so the rehearsal is faithful. Beyond the SCSI nodes above that needs three
# more things, all gated on mhvtl being present and none touching a real
# library (it rearranges the running virtual library through its own I/O
# station and never restarts or signals the daemons):
#   * --ipc=host (tape-archiver >= 0.0.14), so the worker can send operator
#     commands to the mhvtl daemons over their SysV message queue.
#   * all-or-nothing: a partly present virtual library (e.g. a vtltape@1x that
#     did not come back; vtltape@.service is KillMode=none) is logged and not
#     passed through, since a one-drive library cannot rehearse a two-copy run.
#   * /etc/mhvtl AND the media home bind-mounted rw, so make_vtl_media (bundled
#     in the image, not required on the host) can rewrite library_contents.10
#     and regenerate media. The media home is NOT hardcoded: the generator
#     sources MHVTL_HOME_PATH out of /etc/mhvtl/mhvtl.conf the same way mhvtl's
#     own tooling does, and mounts it at the same path the worker resolves it to
#     (tape-archiver >= 0.0.11, "honor mhvtl.conf"). Guessing a path instead
#     made the worker write a full media set into its own ephemeral filesystem
#     and report success (upstream #335). On THIS host the home lives under
#     {{ tape_archiver_pool_mount }} (/mnt/bulk-pool-01/tape-staging/mhvtl), already
#     covered by the pool bind-mount below, so this extra mount is redundant but
#     harmless — and keeps the unit correct if the home ever moves off-pool.
RuntimeDirectory=tape-archiver-worker
EnvironmentFile=-/run/tape-archiver-worker/mhvtl-devices.env
ExecStartPre=/bin/sh -c 'F=/run/tape-archiver-worker/mhvtl-devices.env; : > "$F"; N="/dev/mhvtl/changer /dev/mhvtl/drive0 /dev/mhvtl/drive1 /dev/mhvtl/sg-changer /dev/mhvtl/sg-drive0 /dev/mhvtl/sg-drive1"; P=0; for d in $N; do [ -e "$d" ] && P=$((P+1)); done; if [ "$P" != 6 ]; then [ "$P" = 0 ] || echo "mhvtl is only partly present ($P of 6 /dev/mhvtl nodes); dry runs are disabled" >&2; else FLAGS=""; for d in $N; do R=$(readlink -f "$d"); FLAGS="$FLAGS --device $R --device $R:$d"; done; for c in /dev/mhvtl10 /dev/mhvtl11 /dev/mhvtl12; do [ -e "$c" ] && FLAGS="$FLAGS --device $c"; done; FLAGS="$FLAGS --ipc=host --mount type=bind,source=/etc/mhvtl,target=/etc/mhvtl"; H=$(. /etc/mhvtl/mhvtl.conf >/dev/null 2>&1; echo "$MHVTL_HOME_PATH"); [ -d "$H" ] && FLAGS="$FLAGS --mount type=bind,source=$H,target=$H"; echo "MHVTL_DEVICE_FLAGS=$FLAGS" > "$F"; fi'

# Fail fast naming a missing required device, instead of docker run exiting
# 127 with "error gathering device information".
ExecStartPre=/bin/sh -c 'for d in {{ (tape_archiver_tape_devices + [tape_archiver_changer_device] + tape_archiver_sg_discovery.stdout_lines + ["/dev/zfs", "/dev/fuse"]) | join(" ") }}; do [ -e "$d" ] || { echo "required device $d is missing" >&2; exit 1; }; done'

# All run configuration lives in the env file, never hardcoded in this unit.
EnvironmentFile=/etc/tape-archiver/data-worker.env

# The pool bind mount only propagates the on-demand .zfs/snapshot/<snap>/
# automounts into the container when the host mount is a shared mount. This is
# THE silent-data-loss footgun: get it wrong and snapshot contents are simply
# invisible inside the container — no error, just missing files. Make the pool
# subtree rshared before every start so bind-propagation=rslave has effect.
ExecStartPre=/bin/mount --make-rshared {{ tape_archiver_pool_mount }}
# Clear any leftover container from an unclean stop (ignore failure if none).
ExecStartPre=-/usr/bin/docker rm -f tape-archiver-data-worker

# Device passthrough (SPEC §4.1): both drives' non-rewinding nodes, the
# changer, and their generic SCSI (/dev/sg*) nodes for raw SG_IO — the sg*
# list is discovered per-run by ansible via `lsscsi -g` since the numbers
# depend on SCSI discovery order. /dev/zfs is read-only ioctls for `zfs get`;
# /dev/fuse is required because LTFS is FUSE-based.
#
# Capabilities: SYS_ADMIN — LTFS/FUSE cannot mount without it. SYS_RAWIO —
# the changer, `sg_raw`, and LTFS issue raw SCSI via SG_IO; without it library
# moves fail with EPERM.
#
# apparmor=unconfined: SYS_ADMIN satisfies seccomp for mount(), but Docker's
# default AppArmor profile ALSO carries an unconditional `deny mount,` that
# vetoes the FUSE mount regardless of capabilities. Without lifting it LTFS
# opens the drive, loads the cartridge and reads the volume, then dies at the
# final step with `fuse: mount failed: Permission denied`. This container
# already runs with SYS_ADMIN + SYS_RAWIO and raw SCSI/FUSE device
# passthrough, so the docker-default profile was providing no meaningful
# confinement for it anyway.
ExecStart=/usr/bin/docker run --rm --name tape-archiver-data-worker \
    --pull=never \
    --env-file /etc/tape-archiver/data-worker.env \
    --publish {{ tape_archiver_metrics_port }}:{{ tape_archiver_metrics_port }} \
{% for device in tape_archiver_tape_devices %}
    --device {{ device }} \
{% endfor %}
    --device {{ tape_archiver_changer_device }} \
{% for device in tape_archiver_sg_discovery.stdout_lines %}
    --device {{ device }} \
{% endfor %}
    --device /dev/zfs \
    --device /dev/fuse \
    $MHVTL_DEVICE_FLAGS \
    --cap-add SYS_ADMIN \
    --cap-add SYS_RAWIO \
    --security-opt apparmor=unconfined \
    --mount type=bind,source={{ tape_archiver_pool_mount }},target={{ tape_archiver_pool_mount }},bind-propagation=rslave \
    --mount type=bind,source=/run/tape-archiver/jwt,target=/var/run/teleport/jwt,readonly \
    ${TAPE_ARCHIVER_IMAGE}

# Graceful shutdown: SIGTERM lets the worker stop polling and drain its
# in-flight activity instead of being killed mid-write at Docker's 10s
# default. TimeoutStopSec must exceed the `docker stop` timeout so systemd
# does not SIGKILL the container first.
ExecStop=/usr/bin/docker stop --time={{ tape_archiver_stop_timeout }} tape-archiver-data-worker
TimeoutStopSec={{ tape_archiver_stop_timeout + 60 }}

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
